// Default Ubuntu-based DevContainer Template.
// For more customization options, see https://containers.dev/implementors/json_reference
{
  "build": {
    "context": "..",
    "dockerfile": "./Dockerfile"
  },
  "postCreateCommand": ".devcontainer/scripts/setup.sh",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [
    // Development
    22111,
    22112,
    // production
    23111,
    23112,
    // PostgreSQL
    5432,
    5433
  ],
  "customizations": {
    "jetbrains": {
      "backend": "IntelliJ",
      "plugins": [
        // Conventional Commit: https://plugins.jetbrains.com/plugin/13389-conventional-commit
        "com.github.lppedd.idea-conventional-commit"
      ]
    }
  },
  // SSH agent from the host, for Git over SSH in IntelliJ and VS Code.
  // Defaults to the Linux systemd ssh-agent socket. On macOS (Docker Desktop),
  // export DEVCONTAINER_SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock on the
  // host before opening the container.
  "mounts": [
    "source=${localEnv:DEVCONTAINER_SSH_AUTH_SOCK:/run/user/1000/ssh-agent.socket},target=/ssh-agent,type=bind"
  ],
  "remoteEnv": { "SSH_AUTH_SOCK": "/ssh-agent" }
}
